import Mathlib
import ACC.EqualityComponents

/-!
# Equality edges determine a canonical exact boundary quotient

The earlier contraction theorem requires an externally supplied surjective
component map. Here a finite list of equality edges itself induces an
equivalence relation, and its quotient map is canonically surjective.

This discharges the *mathematical edge-to-component specification*, not yet
the refinement that a particular Rust union-find implementation computes
those classes or meets a bit-cost guarantee.
-/

namespace ACC.EqualityEdgeClosure

open scoped BigOperators
open ACC.EqualityComponents

variable {I : Type*}

/-- Raw equality edges are directed pairs; the generated equivalence
    relation automatically closes them under symmetry and transitivity. -/
def EdgeConnected (edges : List (I × I)) (a b : I) : Prop :=
  Relation.EqvGen (fun u v : I => (u, v) ∈ edges) a b

/-- The canonical partition induced by the edge list, not an oracle. -/
def edgeSetoid (edges : List (I × I)) : Setoid I where
  r := EdgeConnected edges
  iseqv := ⟨
    (fun a => Relation.EqvGen.refl a),
    (fun _ _ h => Relation.EqvGen.symm _ _ h),
    (fun _ _ _ h k => Relation.EqvGen.trans _ _ _ h k)⟩

/-- The actual boundary representation labels are equivalence classes. -/
def edgeClass (edges : List (I × I)) (i : I) :
    Quotient (edgeSetoid edges) :=
  Quotient.mk (edgeSetoid edges) i

theorem edgeClass_surjective (edges : List (I × I)) :
    Function.Surjective (edgeClass edges) := by
  intro c
  induction c using Quotient.inductionOn with
  | _ i => exact ⟨i, rfl⟩

/-- Edge constraints imply equality along every generated path, even
    when the input has duplicate, reversed, cyclic, or self edges. -/
theorem edge_values_iff_connected
    (edges : List (I × I)) (x : I → Bool) :
    (∀ e ∈ edges, x e.1 = x e.2) ↔
      (∀ a b, EdgeConnected edges a b → x a = x b) := by
  constructor
  · intro hed a b hab
    induction hab with
    | rel u v huv =>
        exact hed (u, v) huv
    | refl _ => rfl
    | symm _ _ _ ih => exact ih.symm
    | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  · intro h e he
    exact h e.1 e.2 (Relation.EqvGen.rel _ _ he)

/-- No additional choice or quotient correctness hypothesis is needed:
    the edge-list semantics equals compatibility with its quotient map. -/
theorem edge_values_iff_class_compatible
    (edges : List (I × I)) (x : I → Bool) :
    (∀ e ∈ edges, x e.1 = x e.2) ↔
      Compatible (edgeClass edges) x := by
  rw [edge_values_iff_connected]
  constructor
  · intro h a b hab
    exact h a b (Quotient.exact hab)
  · intro h a b hab
    exact h a b (Quotient.sound hab)

/-- In particular every accepted edge has both endpoints in the
    same component, and any connection along edges has the same label. -/
theorem edgeClass_eq_iff_connected (edges : List (I × I)) (a b : I) :
    edgeClass edges a = edgeClass edges b ↔
      EdgeConnected edges a b := by
  exact Quotient.eq

/-- The already kernel-checked contraction identity now applies to
    *the canonical quotient generated by the actual edge list*. -/
theorem edge_contraction_eq_component_product
    [Fintype I] [DecidableEq I]
    (edges : List (I × I)) (weight : I → Bool → ℤ) :
    (∑ x : {x : I → Bool // Compatible (edgeClass edges) x},
       ∏ i : I, weight i (x.1 i)) =
    ∏ c : Quotient (edgeSetoid edges), ∑ bit : Bool,
      ∏ i ∈ (Finset.univ : Finset I) with edgeClass edges i = c,
        weight i bit := by
  classical
  exact sum_compatible_eq_component_product
    (edgeClass edges) (edgeClass_surjective edges) weight

#print axioms ACC.EqualityEdgeClosure.edge_values_iff_connected
#print axioms ACC.EqualityEdgeClosure.edge_values_iff_class_compatible
#print axioms ACC.EqualityEdgeClosure.edge_contraction_eq_component_product

end ACC.EqualityEdgeClosure
