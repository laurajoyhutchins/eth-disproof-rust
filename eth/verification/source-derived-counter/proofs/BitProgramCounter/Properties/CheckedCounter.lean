import BitProgramCounter.Code.Funs

/-!
# Kernel-checked source-derived Rust counter arithmetic

The definitions of checked_counter.checked_live_bit_step and
source_counter_step are generated by pinned Charon/Aeneas from the *actual*
production Rust file, and regenerated in CI before this proof is checked.
No handwritten replacement of the Rust function appears in this module.

Aeneas's integer and Result operations, source translation correctness,
and native compiler execution remain separate trusted boundaries.
-/

namespace BitProgramCounter

open Aeneas Aeneas.Std Result

/-- Exact mathematical interpretation of every production Rust outcome.
There is deliberately no allowed Push overflow on a representable limit. -/
def CounterMeaning (outcome : checked_counter.CounterOutcome)
    (action : checked_counter.CounterAction) (cached limit : Nat) : Prop :=
  match action, outcome with
  | .Push, .Allowed next => cached < limit ∧ next.val = cached + 1
  | .Push, .Capacity => limit ≤ cached
  | .Push, .Overflow => False
  | .PopNonempty, .Allowed next => 0 < cached ∧ next.val = cached - 1
  | .PopNonempty, .Overflow => cached = 0
  | .PopNonempty, .Capacity => False
  | .Unchanged, .Allowed next => next.val = cached
  | .Unchanged, .Capacity => False
  | .Unchanged, .Overflow => False

private theorem usize_within_max (x : Std.Usize) :
    x.val ≤ Usize.max := by
  have hb := UScalar.hrBounds x
  simpa only [UScalar.rMax_eq_max, UScalar.max_USize_eq] using hb

private theorem checked_add_one_admitted (cached limit : Std.Usize)
    (hadmit : cached.val < limit.val) :
    ∃ next, Usize.checked_add cached 1#usize = some next ∧
      next.val = cached.val + 1 := by
  have hword := usize_within_max limit
  have hspec := Usize.checked_add_bv_spec cached 1#usize
  cases hs : Usize.checked_add cached 1#usize with
  | none =>
      simp [hs] at hspec
      omega
  | some next =>
      simp [hs] at hspec
      exact ⟨next, rfl, hspec.2.1⟩

private theorem checked_sub_one_nonempty (cached : Std.Usize)
    (hpositive : 0 < cached.val) :
    ∃ next, Usize.checked_sub cached 1#usize = some next ∧
      next.val = cached.val - 1 := by
  have hspec := Usize.checked_sub_bv_spec cached 1#usize
  cases hs : Usize.checked_sub cached 1#usize with
  | none =>
      simp [hs] at hspec
      omega
  | some next =>
      simp [hs] at hspec
      exact ⟨next, rfl, hspec.2.1⟩

private theorem checked_sub_one_empty (cached : Std.Usize)
    (hzero : cached.val = 0) :
    Usize.checked_sub cached 1#usize = none := by
  have hspec := Usize.checked_sub_bv_spec cached 1#usize
  cases hs : Usize.checked_sub cached 1#usize with
  | none => rfl
  | some next =>
      simp [hs] at hspec
      omega

/-- Universal checked-refusal and arithmetic theorem for the actual
Aeneas-generated Rust function. It includes every represented machine word,
all three action constructors, and the absence of interpreter failure.
A denied Push is Capacity, a zero-cell nonempty Pop is Overflow, and an
accepted transition returns the exact natural-number successor. -/
theorem extracted_counter_matches_nat_contract
    (action : checked_counter.CounterAction)
    (cached limit : Std.Usize) :
    ∃ outcome,
      source_counter_step action cached limit = .ok outcome ∧
      CounterMeaning outcome action cached.val limit.val := by
  cases action with
  | Push =>
      by_cases hfull : limit.val ≤ cached.val
      · have hcmp : cached ≥ limit := by
          change limit.val ≤ cached.val
          exact hfull
        refine ⟨.Capacity, ?_, ?_⟩
        · simp [source_counter_step, checked_counter.checked_live_bit_step,
            hcmp]
        · simp [CounterMeaning, hfull]
      · have hlt : cached.val < limit.val := by omega
        have hcmp : ¬ cached ≥ limit := by
          intro hc
          have hv : limit.val ≤ cached.val := hc
          exact hfull hv
        obtain ⟨next, hchecked, hnext⟩ :=
          checked_add_one_admitted cached limit hlt
        refine ⟨.Allowed next, ?_, ?_⟩
        · simp [source_counter_step, checked_counter.checked_live_bit_step,
            hcmp, hchecked, Aeneas.Std.lift]
        · simp [CounterMeaning, hlt, hnext]
  | PopNonempty =>
      by_cases hzero : cached.val = 0
      · have hchecked := checked_sub_one_empty cached hzero
        refine ⟨.Overflow, ?_, ?_⟩
        · simp [source_counter_step, checked_counter.checked_live_bit_step,
            hchecked, Aeneas.Std.lift]
        · simp [CounterMeaning, hzero]
      · have hpositive : 0 < cached.val := by omega
        obtain ⟨next, hchecked, hnext⟩ :=
          checked_sub_one_nonempty cached hpositive
        refine ⟨.Allowed next, ?_, ?_⟩
        · simp [source_counter_step, checked_counter.checked_live_bit_step,
            hchecked, Aeneas.Std.lift]
        · simp [CounterMeaning, hpositive, hnext]
  | Unchanged =>
      refine ⟨.Allowed cached, ?_, ?_⟩
      · simp [source_counter_step, checked_counter.checked_live_bit_step]
      · simp [CounterMeaning]

#print axioms BitProgramCounter.extracted_counter_matches_nat_contract

end BitProgramCounter
