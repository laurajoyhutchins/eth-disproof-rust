import Mathlib
import ACC.EqualityEdgeClosure

/-!
# A small mathematical certificate for an equality-component partition

A candidate partition may be verified without trusting the algorithm that
produced it. The certificate contains labels and a sublist-supported forest.
Three conditions suffice: each forest edge appears in the source edge list;
every source edge stays inside one label; and vertices with equal labels are
connected by forest edges. The latter is the finite reachability obligation
of the independent Rust certificate checker.

These conditions prove equality of the candidate partition and the canonical
edge-generated quotient, and recover exact weighted contraction with candidate
labels. This does not yet formally refine the Rust BFS checker or DSU.
-/

namespace ACC.EqualityCertificate

open scoped BigOperators
open ACC.EqualityComponents
open ACC.EqualityEdgeClosure

variable {I C : Type*}

/-- A proof-carrying partition specification. All conditions are about
    the supplied edge list and claimed labels, never DSU parent pointers. -/
structure Conditions
    (edges forest : List (I × I)) (label : I → C) : Prop where
  forest_source : ∀ e ∈ forest, e ∈ edges
  source_closed : ∀ e ∈ edges, label e.1 = label e.2
  forest_spans_classes : ∀ a b, label a = label b →
    EdgeConnected forest a b

/-- Any path generated by the certificate forest is a path in the
    actual input, because every claimed forest edge names an input edge. -/
theorem forest_path_in_source
    (edges forest : List (I × I))
    (hSource : ∀ e ∈ forest, e ∈ edges)
    {a b : I} (h : EdgeConnected forest a b) :
    EdgeConnected edges a b := by
  induction h with
  | rel u v huv =>
      exact Relation.EqvGen.rel _ _ (hSource (u, v) huv)
  | refl _ => exact Relation.EqvGen.refl _
  | symm _ _ _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans _ _ _ _ _ ih₁ ih₂ =>
      exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

/-- Every source path must remain inside one claimed label. -/
theorem connected_same_label
    (edges : List (I × I)) (label : I → C)
    (hClosed : ∀ e ∈ edges, label e.1 = label e.2)
    {a b : I} (h : EdgeConnected edges a b) :
    label a = label b := by
  induction h with
  | rel u v huv => exact hClosed (u, v) huv
  | refl _ => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- The key refinement boundary: a passing certificate makes
    label equality *equivalent* to connectedness in the source graph. -/
theorem label_eq_iff_edge_connected
    (edges forest : List (I × I)) (label : I → C)
    (h : Conditions edges forest label)
    (a b : I) :
    label a = label b ↔ EdgeConnected edges a b := by
  constructor
  · intro hab
    exact forest_path_in_source edges forest h.forest_source
      (h.forest_spans_classes a b hab)
  · intro hab
    exact connected_same_label edges label h.source_closed hab

/-- The exact source-edge constraint is the certified label constraint. -/
theorem source_edges_iff_compatible
    (edges forest : List (I × I))
    (label : I → C)
    (h : Conditions edges forest label)
    (x : I → Bool) :
    (∀ e ∈ edges, x e.1 = x e.2) ↔ Compatible label x := by
  rw [edge_values_iff_connected]
  constructor
  · intro hs a b hab
    exact hs a b ((label_eq_iff_edge_connected edges forest label h a b).mp hab)
  · intro hs a b hab
    exact hs a b ((label_eq_iff_edge_connected edges forest label h a b).mpr hab)

/-- The label map is an exact replacement for the quotient in the
    admissible-assignment space, given certificate obligations. -/
noncomputable def assignmentsEquiv
    (edges forest : List (I × I))
    (label : I → C)
    (h : Conditions edges forest label) :
    {x : I → Bool // ∀ e ∈ edges, x e.1 = x e.2} ≃
    {x : I → Bool // Compatible label x} where
  toFun x := ⟨x.1, (source_edges_iff_compatible edges forest label h x.1).mp x.2⟩
  invFun x := ⟨x.1, (source_edges_iff_compatible edges forest label h x.1).mpr x.2⟩
  left_inv x := by
    apply Subtype.ext
    rfl
  right_inv x := by
    apply Subtype.ext
    rfl

/-- Once the externally checkable certificate conditions and label
    surjectivity hold, the already-proved exact component contraction is
    valid for the original edge list and claimed labels. -/
theorem certified_contraction
    [Fintype I] [Fintype C] [DecidableEq I] [DecidableEq C]
    (edges forest : List (I × I))
    (label : I → C)
    (h : Conditions edges forest label)
    (hs : Function.Surjective label)
    (weight : I → Bool → ℤ) :
    (∑ x : {x : I → Bool // ∀ e ∈ edges, x e.1 = x e.2},
       ∏ i : I, weight i (x.1 i)) =
    ∏ c : C, ∑ bit : Bool,
      ∏ i ∈ (Finset.univ : Finset I) with label i = c,
        weight i bit := by
  classical
  calc
    (∑ x : {x : I → Bool // ∀ e ∈ edges, x e.1 = x e.2},
       ∏ i : I, weight i (x.1 i)) =
      ∑ x : {x : I → Bool // Compatible label x},
        ∏ i : I, weight i (x.1 i) := by
      refine Fintype.sum_equiv (assignmentsEquiv edges forest label h) _ _ ?_
      intro x
      rfl
    _ = _ := sum_compatible_eq_component_product label hs weight

#print axioms ACC.EqualityCertificate.label_eq_iff_edge_connected
#print axioms ACC.EqualityCertificate.source_edges_iff_compatible
#print axioms ACC.EqualityCertificate.certified_contraction

end ACC.EqualityCertificate
