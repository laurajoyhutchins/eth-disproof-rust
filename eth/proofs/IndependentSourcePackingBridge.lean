import Mathlib
import Groundwork.Net.Net
import IndependentOpenAIPacketPreservation

/-!
# Constructive real-port packing and a source-network contraction encoding

The first part constructs an *actual* aligned, injective packing for any
finite Boolean edge set, by deterministic division into packets of L
slots. This closes the prerequisite of the OpenAI Cauchy identity, but
does NOT assert the manuscript's additional color-orientation and
load-balancing properties.

The second part encodes the *same two-sided Boolean edge contraction*
as a Groundwork.Network using the unmodified Anthropic source semantics.
The two vertices represent the two bipartite sides and the shared
edge-label alphabet is (E -> Bool). The construction is exact but
may increase the label-table representation exponentially. It is not
claimed to be the network generated by Anthropic's SAT algorithm.
-/

namespace IndependentETH.SourcePackingBridge

open scoped BigOperators
open IndependentETH.OpenAIPackets

/-- Enumerate the real edges once and place index k in packet k/L,
slot k mod L. Both endpoints use this same packet-slot location. -/
noncomputable def enumeratePacking (E : Type*) [Fintype E] (L : ℕ)
    (hL : 0 < L) : ValidPacking E ℕ L where
  packet e := ((Fintype.equivFin E e).val) / L
  slot e := ⟨((Fintype.equivFin E e).val) % L, Nat.mod_lt _ hL⟩
  injective := by
    intro e f h
    have hpacket :
        ((Fintype.equivFin E e).val) / L =
        ((Fintype.equivFin E f).val) / L := congrArg Prod.fst h
    have hslot :
        ((Fintype.equivFin E e).val) % L =
        ((Fintype.equivFin E f).val) % L :=
      congrArg Fin.val (congrArg Prod.snd h)
    have hrank :
        ((Fintype.equivFin E e).val) =
        ((Fintype.equivFin E f).val) := by
      calc
        _ = ((Fintype.equivFin E e).val) % L +
            L * (((Fintype.equivFin E e).val) / L) :=
              (Nat.mod_add_div _ _).symm
        _ = ((Fintype.equivFin E f).val) % L +
            L * (((Fintype.equivFin E f).val) / L) := by
              rw [hpacket, hslot]
        _ = ((Fintype.equivFin E f).val) := Nat.mod_add_div _ _
    exact (Fintype.equivFin E).injective (Fin.ext hrank)

/-- The manuscript's zero-point Cauchy equality, without a
postulated packing: the witness is constructed from every finite E. -/
theorem constructed_deformation_at_zero
    {E R : Type*} [Fintype E] [DecidableEq E] [CommRing R]
    (L : ℕ) (hL : 0 < L) (φ : ℚ →+* R)
    (row column : (E → Bool) → R) :
    deformedContraction (enumeratePacking E L hL) φ row column 0 =
      originalContraction row column :=
  deformedContraction_zero (enumeratePacking E L hL) φ row column

/-- Encode the two sides of a Boolean bipartite tensor network into
the *actual* original Anthropic Groundwork.Network structure.
The single pair-label is a full Boolean edge assignment, so
parallel edges and isolated-vertex scalar factors are all retained
inside the row/column tables; no duplicate-label multiplicity. -/
def twoSideNetwork {E : Type*} [Fintype E] [DecidableEq E]
    (row column : (E → Bool) → ℤ) :
    Groundwork.Network (Fin 2) Unit (E → Bool) where
  S _ := {()}
  W _ _ := 1
  Θ _ _ := Finset.univ
  f a _ _ x := if a = 0 then row x else column x
  c _ _ := 0

private theorem pairs_two :
    Groundwork.pairs (Fin 2) = {((0 : Fin 2), (1 : Fin 2))} := by
  decide

/-- On exactly two nodes with unit states, the original Anthropic
source value is the shared-label two-sided contraction. -/
theorem twoSideNetwork_value
    {E : Type*} [Fintype E] [DecidableEq E]
    (row column : (E → Bool) → ℤ) :
    (twoSideNetwork row column).value =
      originalContraction row column := by
  classical
  simp [Groundwork.Network.value, Groundwork.Network.Ψ,
    Groundwork.Network.lab, pairs_two,
    twoSideNetwork, originalContraction, Fin.prod_univ_two]

/-- The compositional comparison square at the common initial
Boolean network: OpenAI's actual Cauchy deformation at T=0
equals Anthropic's actual Network.value on its explicit
two-sided representation of the same input factors.

This is deliberately not an identification of the two full
SAT-algorithm-generated network representations. -/
theorem constructed_packet_eq_source_network
    {E : Type*} [Fintype E] [DecidableEq E]
    (L : ℕ) (hL : 0 < L)
    (row column : (E → Bool) → ℤ) :
    deformedContraction (enumeratePacking E L hL) (RingHom.id ℚ)
        (fun x => (row x : ℚ)) (fun x => (column x : ℚ)) 0 =
      ((twoSideNetwork row column).value : ℚ) := by
  rw [constructed_deformation_at_zero]
  rw [twoSideNetwork_value]
  unfold originalContraction
  simp

#print axioms IndependentETH.SourcePackingBridge.constructed_deformation_at_zero
#print axioms IndependentETH.SourcePackingBridge.twoSideNetwork_value
#print axioms IndependentETH.SourcePackingBridge.constructed_packet_eq_source_network

end IndependentETH.SourcePackingBridge
