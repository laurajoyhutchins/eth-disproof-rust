# Supply optional native inputs even when the sdist is built as pure Python.
include native_ring.pyx native_sparse.pyx native_recursive.pyx
include native_ring.pxd native_ring.pyi native_sparse.pyi native_recursive.pyi
include build_native.py setup.py pyproject.toml README.md
recursive-include docs *.md
recursive-include scripts *.py
recursive-include benchmarks *.py *.json *.md
recursive-include tests *.py *.json
recursive-include reference *.py
recursive-include research *.py
